{
  "name": "j-rig-binary-eval",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Seven-layer binary evaluation harness and rollout gate for Claude Skills",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:skill-gates": "python3 tests/skill-gates/test_claude.py",
    "typecheck": "tsc --noEmit -p tests/tsconfig.json && pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run typecheck:workspace && pnpm run verify:workspace",
    "test:coverage": "vitest run --coverage",
    "test:coverage:refiner-core": "vitest run --coverage --config packages/refiner-core/vitest.config.ts",
    "lint:md": "markdownlint-cli2",
    "emit:evidence": "node --experimental-strip-types scripts/emit-evidence.ts",
    "assemble:manifest": "node --experimental-strip-types scripts/assemble-manifest.ts",
    "license:audit": "node --experimental-strip-types scripts/license-audit.ts --prod",
    "harness:verify": "scripts/audit-harness verify",
    "harness:init": "scripts/audit-harness init",
    "verify:workspace": "tsx scripts/workspace-architecture.ts && tsx scripts/workspace-quality.ts bias && tsx scripts/workspace-quality.ts gherkin",
    "typecheck:workspace": "tsc --ignoreConfig --types node --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck --allowImportingTsExtensions scripts/workspace-inventory.ts scripts/workspace-quality.ts scripts/workspace-quality.test.ts scripts/workspace-architecture.ts scripts/workspace-architecture.test.ts scripts/workspace-coverage-*.ts scripts/workspace-coverage.test.ts scripts/workspace-crap.ts scripts/workspace-crap.test.ts",
    "test:coverage:workspace": "tsx scripts/workspace-coverage-run.ts",
    "verify:crap": "tsx scripts/workspace-crap.ts"
  },
  "lint-staged": {
    "*.{ts,js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@intentsolutions/core": "0.11.0",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "ast-v8-to-istanbul": "0.3.12",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "3.2.2",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "7.3.1",
    "vitest": "5.0.5"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeremylongshore/j-rig-skill-binary-eval.git"
  },
  "author": "Jeremy Longshore <jeremy@jeremylongshore.com>",
  "pnpm": {
    "overrides": {
      "gray-matter>js-yaml": "^3.15.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ],
    "patchedDependencies": {
      "tsup@8.5.1": "patches/tsup@8.5.1.patch"
    }
  }
}
